        T.func_attr({"tir.noalias": True})
        with T.block("root"):
            T.reads()
            T.writes()
            T.block_attr({"meta_schedule.parallel": 128, "meta_schedule.unroll_explicit": 16, "meta_schedule.vectorize": 64})
            C_global = T.alloc_buffer((384, 768))
            for i_0, j_0, i_1, j_1 in T.grid(4, 8, 1, 48):
                for k_0, i_2, j_2, k_1, i_3, j_3 in T.grid(192, 8, 1, 4, 12, 2):
                    with T.block("C"):
                        vi = T.axis.spatial(384, i_0 * 96 + i_1 * 96 + i_2 * 12 + i_3)
                        vj = T.axis.spatial(768, j_0 * 96 + j_1 * 2 + j_2 * 2 + j_3)
                        vk = T.axis.reduce(768, k_0 * 4 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
                        T.writes(C_global[vi, vj])
                        T.block_attr({"meta_schedule.tiling_structure": "SSRSRS"})
                        with T.init():
