                        v0 = T.axis.spatial(16, i_0 * 4 + ax0)
                        v1 = T.axis.spatial(768, j_1 * 4 + ax1)
                        T.reads(C_global[v0, v1])
                        T.writes(C[v0, v1])
                        C[v0, v1] = C_global[v0, v1]
