@I.ir_module
class Module:
    @T.prim_func
    def main(A: T.Buffer((256, 3072), "float32"), B: T.Buffer((3072, 768), "float32"), C: T.Buffer((256, 768), "float32")):
        T.func_attr({"tir.noalias": True})
        # with T.block("root"):
        for i, j, k in T.grid(256, 768, 3072):
            with T.block("C"):
                vi, vj, vk = T.axis.remap("SSR", [i, j, k])
                T.reads(A[vi, vk], B[vk, vj])
                T.writes(C[vi, vj])
                with T.init():
                    C[vi, vj] = T.float32(0.0)
                C[vi, vj] = C[vi, vj] + A[vi, vk] * B[vk, vj]
