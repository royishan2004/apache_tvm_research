class Module:
    @T.prim_func
    def main(A: T.Buffer((384, 768), "float32"), B: T.Buffer((768, 768), "float32"), C: T.Buffer((384, 768), "float32")):
        T.func_attr({"tir.noalias": True})
        # with T.block("root"):
        for i, j, k in T.grid(384, 768, 768):
            with T.block("C"):
                vi, vj, vk = T.axis.remap("SSR", [i, j, k])
