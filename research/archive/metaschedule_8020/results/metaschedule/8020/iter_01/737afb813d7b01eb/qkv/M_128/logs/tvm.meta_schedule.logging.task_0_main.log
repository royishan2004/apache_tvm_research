@I.ir_module
class Module:
    @T.prim_func
    def main(A: T.Buffer((128, 768), "float32"), B: T.Buffer((768, 768), "float32"), C: T.Buffer((128, 768), "float32")):
        T.func_attr({"tir.noalias": True})
        with T.block("root"):
            T.reads()
            T.writes()
            T.block_attr({"meta_schedule.parallel": 128, "meta_schedule.unroll_explicit": 512, "meta_schedule.vectorize": 64})
            C_global = T.alloc_buffer((128, 768))
            for i_0, j_0, i_1, j_1 in T.grid(8, 96, 1, 4):
                for k_0, i_2, j_2, k_1, i_3, j_3 in T.grid(48, 4, 2, 16, 4, 1):
                    with T.block("C"):
                        vi = T.axis.spatial(128, i_0 * 16 + i_1 * 16 + i_2 * 4 + i_3)
                        vj = T.axis.spatial(768, j_0 * 8 + j_1 * 2 + j_2 + j_3)
                        vk = T.axis.reduce(768, k_0 * 16 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
                        T.writes(C_global[vi, vj])
                        T.block_attr({"meta_schedule.tiling_structure": "SSRSRS"})
                        with T.init():
                            C_global[vi, vj] = T.float32(0.0)
                        C_global[vi, vj] = C_global[vi, vj] + A[vi, vk] * B[vk, vj]
                for ax0, ax1 in T.grid(16, 2):
                    with T.block("C_global"):
                        v0 = T.axis.spatial(128, i_0 * 16 + ax0)
                        v1 = T.axis.spatial(768, j_0 * 8 + j_1 * 2 + ax1)
                        T.reads(C_global[v0, v1])
                        T.writes(C[v0, v1])
                        C[v0, v1] = C_global[v0, v1]
