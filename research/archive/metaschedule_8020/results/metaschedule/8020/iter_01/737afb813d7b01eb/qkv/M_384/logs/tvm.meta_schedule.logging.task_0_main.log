        T.func_attr({"tir.noalias": True})
        with T.block("root"):
            T.reads()
            T.writes()
            T.block_attr({"meta_schedule.parallel": 128, "meta_schedule.unroll_explicit": 16, "meta_schedule.vectorize": 64})
            C_global = T.alloc_buffer((384, 768))
            for i_0, j_0, i_1, j_1 in T.grid(8, 256, 2, 1):
                for k_0, i_2, j_2, k_1, i_3, j_3 in T.grid(256, 1, 1, 3, 24, 3):
                    with T.block("C"):
                        vi = T.axis.spatial(384, i_0 * 48 + i_1 * 24 + i_2 * 24 + i_3)
                        vj = T.axis.spatial(768, j_0 * 3 + j_1 * 3 + j_2 * 3 + j_3)
                        vk = T.axis.reduce(768, k_0 * 3 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
                        T.writes(C_global[vi, vj])
                        T.block_attr({"meta_schedule.tiling_structure": "SSRSRS"})
                        with T.init():
                            C_global[vi, vj] = T.float32(0.0)
                        C_global[vi, vj] = C_global[vi, vj] + A[vi, vk] * B[vk, vj]
                for ax0, ax1 in T.grid(24, 3):
                    with T.block("C_global"):
                        v0 = T.axis.spatial(384, i_0 * 48 + i_1 * 24 + ax0)
                        v1 = T.axis.spatial(768, j_0 * 3 + ax1)
                        T.reads(C_global[v0, v1])
                        T.writes(C[v0, v1])
                        C[v0, v1] = C_global[v0, v1]
