        with T.block("root"):
            T.reads()
            T.writes()
            T.block_attr({"meta_schedule.parallel": 128, "meta_schedule.unroll_explicit": 0, "meta_schedule.vectorize": 64})
            C_global = T.alloc_buffer((16, 768))
            for i_0, j_0, i_1, j_1 in T.grid(1, 64, 8, 6):
                for k_0, i_2, j_2, k_1, i_3, j_3 in T.grid(24, 1, 2, 32, 2, 1):
                    with T.block("C"):
                        vi = T.axis.spatial(16, i_0 * 16 + i_1 * 2 + i_2 * 2 + i_3)
                        vj = T.axis.spatial(768, j_0 * 12 + j_1 * 2 + j_2 + j_3)
                        vk = T.axis.reduce(768, k_0 * 32 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
                        T.writes(C_global[vi, vj])
                        T.block_attr({"meta_schedule.tiling_structure": "SSRSRS"})
                        with T.init():
                            C_global[vi, vj] = T.float32(0.0)
                        C_global[vi, vj] = C_global[vi, vj] + A[vi, vk] * B[vk, vj]
                for ax0, ax1 in T.grid(2, 2):
