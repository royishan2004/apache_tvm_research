            for i_0, j_0, i_1, j_1 in T.grid(32, 6, 1, 2):
                for k_0, i_2, j_2, k_1, i_3, j_3 in T.grid(128, 2, 32, 24, 6, 2):
                    with T.block("C"):
                        vi = T.axis.spatial(384, i_0 * 12 + i_1 * 12 + i_2 * 6 + i_3)
                        vj = T.axis.spatial(768, j_0 * 128 + j_1 * 64 + j_2 * 2 + j_3)
                        vk = T.axis.reduce(3072, k_0 * 24 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
                        T.writes(C_global[vi, vj])
                        T.block_attr({"meta_schedule.tiling_structure": "SSRSRS"})
                        with T.init():
                            C_global[vi, vj] = T.float32(0.0)
                        C_global[vi, vj] = C_global[vi, vj] + A[vi, vk] * B[vk, vj]
                for ax0, ax1 in T.grid(12, 64):
