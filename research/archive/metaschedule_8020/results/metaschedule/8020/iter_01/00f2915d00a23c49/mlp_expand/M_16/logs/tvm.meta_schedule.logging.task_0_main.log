                        vj = T.axis.spatial(3072, j_0 * 3072 + j_1 * 3072 + j_2 * 24 + j_3)
                        vk = T.axis.reduce(768, k_0 + k_1)
                        T.reads(A[vi, vk], B[vk, vj])
